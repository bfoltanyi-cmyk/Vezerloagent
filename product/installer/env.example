# install.sh copies this to .env. Contains NO secrets - secrets live in ./secrets (generated, 0600).
ERP_IMAGE=registry.example.invalid/alicya/erp:0.1.0
ERP_DOMAIN=erp.example.invalid
PORT=3000
COUNTRY_PACK=hu
DISPLAY_TIMEZONE=Europe/Budapest
# Path to the signed license file inside the container (Ed25519, verified offline).
LICENSE_FILE=/run/license/license.json
